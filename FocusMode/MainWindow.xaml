<Window x:Class="FocusMode.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="집중 모드"
        Height="200" Width="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Topmost="True"
        ShowInTaskbar="True">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 제목 -->
        <TextBlock Grid.Row="0" Text="집중 모드" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

        <!-- 오퍼시티 조절 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="어둡기: " VerticalAlignment="Center" Width="60"/>
            <Slider x:Name="OpacitySlider"
                    Minimum="10" Maximum="100" Value="70"
                    Width="180"
                    VerticalAlignment="Center"
                    ValueChanged="OpacitySlider_ValueChanged"/>
            <TextBlock x:Name="OpacityText" Text="70%" VerticalAlignment="Center" Margin="10,0,0,0" Width="40"/>
        </StackPanel>

        <!-- 핫키 안내 -->
        <TextBlock Grid.Row="2" Text="단축키: Ctrl+Alt+F (토글)" Foreground="Gray" FontSize="11" Margin="0,0,0,10"/>

        <!-- 버튼 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <Button x:Name="ToggleButton" Content="집중 모드 시작" Width="120" Height="35" Click="ToggleButton_Click" Margin="0,0,10,0"/>
            <Button Content="숨기기" Width="80" Height="35" Click="HideButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
